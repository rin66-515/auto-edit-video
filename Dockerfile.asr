FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu128 && pip3 install --break-system-packages --no-cache-dir qwen-asr
WORKDIR /worker
COPY app ./app
CMD ["python3", "-m", "app.asr_worker"]
